				<div id="frma">

					<h2>En savoir plus ? </h2>
					<h3>Demandez-nous une documentation !</h3>
					<p class="textePlusPetit"><i>Les champs marqu&eacute;s d'un ast&eacute;risque (<span class="champObligatoire">*</span>) sont &agrave; remplir obligatoirement et correctement.</i></p>
						<link rel="stylesheet" href="https://www.devinci.fr/wordpress/candidature/assets/plugins/select2/css/select2.css" />

<style type="text/css">
    .form-errors{
  background:#ffe9e9;
  border:1px solid #e20000;
  padding:12px 15px;
  margin-bottom:20px;
  font-size:12px;
  color:#b00000;
}

.form-error{
  color:#e20000;
  font-size:12px;
  margin-top:5px;
}

.input-error,
.select2-container--default.input-error .select2-selection{
  border-color:#e20000 !important;
}
</style>

<form
    name="oscar_form"
    id="oscar_form"
    enctype="multipart/form-data"
    method="post"
    action="https://my.devinci.fr/admissions/prospect.php"
    autocomplete="on"
    onsubmit="return false;"
>
    <div id="form_errors" class="form-errors" style="display:none;"></div> 
    <input type="hidden" name="origine" id="origine" value="Site web ESILV">
    <input type="hidden" name="utmzz" id="utmzz_input" value="">

            <input name="ecole_origine" value="esilv" type="hidden">
    
    <p class="one_third">
        <input
            type="email"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="none"
            spellcheck="false"
            placeholder="Votre email*"
            name="contact_email"
            value=""
            maxlength="150"
            id="contact_email"
        >
    </p>

    <p class="one_third">
        <select multiple="multiple" name="choix_prog[]" id="choix_prog">
            <option value=""></option>

                            <optgroup label="ESILV">
                                            <option value="ESILVCI">Cursus Ingénieur</option>
                                            <option value="ESILVBANUM">Bachelor Informatique & Cybersécurité</option>
                                            <option value="ESILVMSCCRF">MSc Cyber Resilience & Crisis Leadership</option>
                                            <option value="ESILVMSCCS">MSc Computer Science</option>
                                            <option value="ESILVMSEMNSPI">MS Modélisation Numérique</option>
                                    </optgroup>
                    </select>
    </p>

    <p class="one_third last">
        <select multiple="multiple" name="campus[]" id="frm_campus" class="frm_campus">
            <option value="Paris">Paris</option>
            <option value="Montpellier">Montpellier</option>
            <option value="Nantes">Nantes</option>
        </select>
    </p>

    <p class="one_third clear">
        <select name="contact_civilite" size="1" id="contact_civilite" class="decl" autocomplete="honorific-prefix">
            <option value="" selected>Civilité *</option>
            <option value="Madame">Madame</option>
            <option value="Monsieur">Monsieur</option>
        </select>
    </p>

    <p class="one_third">
        <input
            type="text"
            placeholder="Votre prénom*"
            name="contact_prenom"
            autocomplete="given-name"
            autocapitalize="words"
            value=""
            maxlength="50"
            id="contact_prenom"
            onkeyup="Premiere(this)"
            class="decl"
        >
    </p>

    <p class="one_third last">
        <input
            type="text"
            placeholder="Votre nom*"
            name="contact_nom"
            value=""
            maxlength="100"
            id="contact_nom"
            onchange="this.value=this.value.toUpperCase();"
            class="decl"
            autocomplete="family-name"
            autocapitalize="characters"
        >
    </p>

    <div id="frm_part_2" class="clear">

        <p class="one_third clear">
            <input type="text" 
                   placeholder="Votre adresse" 
                   name="contact_adresse1" 
                   value="" 
                   maxlength="255"
                   autocomplete="address-line1"
                   autocapitalize="words"
            >
        </p>

        <p class="one_third">
            <input
                type="text"
                placeholder="Votre code postal*"
                name="contact_code_postal"
                value=""
                maxlength="5"
                id="contact_code_postal"
                autocomplete="postal-code"
                inputmode="numeric"
            >
        </p>

        <p class="one_third last">
            <input
                type="text"
                name="contact_ville"
                placeholder="Votre ville*"
                value=""
                maxlength="100"
                id="contact_ville"
                onchange="this.value=this.value.toUpperCase();"
                autocomplete="address-level2"
                autocapitalize="characters"
            >
        </p>

        <p class="one_third clear">
